using namespace std;
#include <functional>
#include <iostream>
#include <numeric>
#include <vector>

#include "Game.h"

// mv test_cpp test.cpp ; g++ -g *.cpp -o test ; ./test ; rm test.exe ; mv test.cpp test_cpp

void should(bool fact, string message) {
  if (!fact) throw message;
}

void test(string name, function<void()> func) {
  try {
    func();
    cout << ".";
  } catch (const string& e) {
    cout << endl << name << ": " << e << endl;
  }
}

void restoring() {
  test("overwrite pieces", []() {
    Game g;
    g.restore("8/8/8/8/8/8/8/P7 w - - 0 1");
    g.restore("8/8/8/8/8/8/P7/8 w - - 0 1");
    should(g.fen() == "8/8/8/8/8/8/P7/8 w - - 0 1", "Not overwritten: " + g.fen());
  });
}

void moving() {
  test("start with empty board", []() {
    Game g;
    should(g.turn == Game::WHITE, "First turn not white");
    should(g.fen() == "8/8/8/8/8/8/8/8 w - - 0 1", "Not empty: " + g.fen());
  });

  test("blacks turn", []() {
    Game g;
    g.restore("8/8/8/8/8/8/8/8 b - - 0 1");
    should(g.turn == Game::BLACK, "First turn not black");
    should(g.fen() == "8/8/8/8/8/8/8/8 b - - 0 1", "Not blacks turn: " + g.fen());
  });

  test("simple move", []() {
    Game g;
    g.restore("8/8/8/8/8/8/8/7P w - - 0 1");
    g.make(Move{63, 63 - 16});
    should(g.turn == Game::BLACK, "Second turn not black");
    should(g.fen() == "8/8/8/8/8/7P/8/8 b - - 0 1", "Pawn not in 3rd row: " + g.fen());
  });
}

void pawnMoves() {
  test("White start moves", []() {
    Game g;
    g.restore("8/8/8/8/8/8/P7/8 w - - 0 1");
    auto moves = g.moves(48);
    auto printed = accumulate(moves.begin(), moves.end(), string(),
                              [](const string& s, Move m) { return s + "," + Game::print(m); });

    should(printed == ",a2a3,a2a4", "Moves: " + printed);
  });

  test("White normal move", []() {
    Game g;
    g.restore("8/8/8/8/8/P7/8/8 w - - 0 1");
    auto moves = g.moves(40);
    auto printed = accumulate(moves.begin(), moves.end(), string(),
                              [](const string& s, Move m) { return s + "," + Game::print(m); });

    should(printed == ",a3a4", "Moves: " + printed);
  });
}

int main() {
  restoring();
  moving();
  pawnMoves();
}